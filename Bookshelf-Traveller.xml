  <Changes>
### 2026-08-18
- Added WebUI Management Dashboard support (Port 12359) with WebUI button link.
- Added missing environment variables: TIMEZONE, WEBUI_ENABLED, BOT_ENABLED, EPHEMERAL_OUTPUT, TASK_FREQUENCY, UPDATES, FFMPEG_DEBUG, EXPERIMENTAL, INITIALIZED_MSG, and DEFAULT_SERVER_NAME.
- Removed duplicate AUDIO_ENABLED variable entry and fixed typo in persistent database path description.

### 2024-08-13
- Breaking Change: Version 1.2.2 has a new tasks.db structure, you will need to manually delete or change to a new path.
  </Changes>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText>Like this template? Please consider donating :)</DonateText>
  <DonateLink>https://buymeacoffee.com/donkevlar</DonateLink>

  <!-- WebUI Port -->
  <Config Name="WebUI Port" Target="12359" Default="12359" Mode="tcp" Description="Web UI port for the management interface." Type="Port" Display="always" Required="false" Mask="false">12359</Config>

  <!-- Persistent Storage -->
  <Config Name="Persistent DB" Target="/ABSBOT/db" Default="/mnt/user/appdata/bookshelf_traveller/db" Mode="rw" Description="Path for database files to stay persistent across container updates. Delete if you want the container to re-initialize databases on startup." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/bookshelf_traveller/db</Config>

  <!-- Core Required Settings -->
  <Config Name="Discord Token" Target="DISCORD_TOKEN" Default="" Mode="" Description="Discord application bot token from the Discord Developer Portal." Type="Variable" Display="always" Required="true" Mask="true">INSERT_TOKEN</Config>
  <Config Name="Client ID" Target="CLIENT_ID" Default="" Mode="" Description="Discord application client ID from the OAuth2 tab in the Discord Dev Portal (used to generate invite links)." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Bookshelf Token" Target="bookshelfToken" Default="" Mode="" Description="Audiobookshelf API token generated in user settings." Type="Variable" Display="always" Required="true" Mask="true">INSERT_TOKEN</Config>
  <Config Name="Audiobookshelf URL" Target="bookshelfURL" Default="http://127.0.0.1:13378" Mode="" Description="Audiobookshelf server URL with protocol and port. Example: http://192.168.1.100:13378" Type="Variable" Display="always" Required="true" Mask="false">http://127.0.0.1:13378</Config>
  <Config Name="HTTPS Image URL" Target="OPT_IMAGE_URL" Default="" Mode="" Description="Optional HTTPS URL for fetching cover images when your primary ABS server URL is direct HTTP." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Timezone" Target="TIMEZONE" Default="America/Toronto" Mode="" Description="Timezone for timestamps (e.g., America/Toronto, America/New_York, Europe/London)." Type="Variable" Display="always" Required="false" Mask="false">America/Toronto</Config>

  <!-- Bot & UI Services -->
  <Config Name="Enable Web UI" Target="WEBUI_ENABLED" Default="true" Mode="" Description="Enable or disable the FastAPI Web Management Interface." Type="Variable" Display="advanced-hide" Required="false" Mask="false">true</Config>
  <Config Name="Enable Bot" Target="BOT_ENABLED" Default="true" Mode="" Description="Enable or disable the Discord bot process." Type="Variable" Display="advanced-hide" Required="false" Mask="false">true</Config>

  <!-- Permissions & Roles -->
  <Config Name="Owner Only" Target="OWNER_ONLY" Default="True" Mode="" Description="If True, only the bot owner (or users with Playback Role) can execute commands." Type="Variable" Display="advanced-hide" Required="false" Mask="false">True</Config>
  <Config Name="Playback Role" Target="PLAYBACK_ROLE" Default="0" Mode="" Description="Discord Role ID for non-owners allowed to use audio playback commands. Set to 0 to disable." Type="Variable" Display="advanced-hide" Required="false" Mask="false">0</Config>
  <Config Name="Multi-User" Target="MULTI_USER" Default="True" Mode="" Description="Enables multi-user login to the ABS server. Disable to restrict to admin." Type="Variable" Display="advanced-hide" Required="false" Mask="false">True</Config>

  <!-- Audio & Playback Options -->
  <Config Name="Enable Audio Playback" Target="AUDIO_ENABLED" Default="True" Mode="" Description="Enables the voice channel audio streaming module." Type="Variable" Display="advanced-hide" Required="false" Mask="false">True</Config>
  <Config Name="Default Search Provider" Target="DEFAULT_PROVIDER" Default="audible" Mode="" Description="Default search provider for wishlist queries (options: audible, openlibrary, google, itunes, etc.)." Type="Variable" Display="advanced-hide" Required="false" Mask="false">audible</Config>
  <Config Name="Ephemeral Output" Target="EPHEMERAL_OUTPUT" Default="True" Mode="" Description="Sets slash command responses to be ephemeral (visible only to the user who triggered it)." Type="Variable" Display="advanced-hide" Required="false" Mask="false">True</Config>
  <Config Name="Default Server Name" Target="DEFAULT_SERVER_NAME" Default="Audiobookshelf" Mode="" Description="Custom server display name used in notifications." Type="Variable" Display="advanced-hide" Required="false" Mask="false">Audiobookshelf</Config>

  <!-- Tasks & Intervals -->
  <Config Name="Task Frequency (Minutes)" Target="TASK_FREQUENCY" Default="5" Mode="" Description="Interval in minutes for background subscription tasks (new books, finished books)." Type="Variable" Display="advanced-hide" Required="false" Mask="false">5</Config>
  <Config Name="Playback Update Interval (Seconds)" Target="UPDATES" Default="5" Mode="" Description="Playback session progress sync interval in seconds." Type="Variable" Display="advanced-hide" Required="false" Mask="false">5</Config>

  <!-- Diagnostics & Notifications -->
  <Config Name="Startup Owner Notification" Target="INITIALIZED_MSG" Default="True" Mode="" Description="Send a startup DM notification to the bot owner." Type="Variable" Display="advanced-hide" Required="false" Mask="false">True</Config>
  <Config Name="Experimental Features" Target="EXPERIMENTAL" Default="False" Mode="" Description="Enable experimental bot commands and features." Type="Variable" Display="advanced-hide" Required="false" Mask="false">False</Config>
  <Config Name="Debug Mode" Target="DEBUG_MODE" Default="False" Mode="" Description="Enables verbose debugging logs and suppresses user notifications." Type="Variable" Display="advanced-hide" Required="false" Mask="false">False</Config>
  <Config Name="FFmpeg Debug Logging" Target="FFMPEG_DEBUG" Default="False" Mode="" Description="Creates verbose FFmpeg log files inside the db directory." Type="Variable" Display="advanced-hide" Required="false" Mask="false">False</Config>
</Container>
